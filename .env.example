# Copy to .env and fill in. The Makefile loads .env automatically.

# LLM providers are declared in agent-assets/config/llms.yaml (embedded in the API).
# Point this at another file to change providers without a rebuild.
# LLM_CONFIG_PATH=/etc/ai-platform/llms.yaml

# API keys: one env var per provider, named by `apiKeyEnv` in llms.yaml.
ANTHROPIC_API_KEY=
# LLM_GATEWAY_API_KEY=

# Optional: point Anthropic providers without a baseURL at another endpoint (e.g. a local fake for demos).
# ANTHROPIC_BASE_URL=http://localhost:8090

# Postgres used by ms-ai-platform (deploy/docker-compose.yml exposes it on 5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agentic?sslmode=disable

# Where the platform reaches demo-mcp.
DEMO_MCP_URL=http://localhost:8081/mcp

# ms-ai-platform listen address.
PORT=8080

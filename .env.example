# Copy to .env and fill in. The Makefile loads .env automatically.

# --- ms-llm-gateway -----------------------------------------------------------
# Upstream LLM providers are declared in ms-llm-gateway/config/llms.yaml (embedded).
# Point this at another file to change providers without a rebuild.
# LLM_CONFIG_PATH=/etc/llm-gateway/llms.yaml

# Upstream API keys: one env var per provider, named by `apiKeyEnv` in llms.yaml.
ANTHROPIC_API_KEY=
# COMPANY_GATEWAY_API_KEY=

# Optional: point Anthropic providers without a baseURL at another endpoint (e.g. a local fake for demos).
# ANTHROPIC_BASE_URL=http://localhost:8090

# Gateway listen address.
# GATEWAY_ADDR=:8082

# Optional: comma-separated keys the gateway accepts as `Authorization: Bearer <key>`.
# Unset means no key is required (keep the gateway on the internal network).
# GATEWAY_API_KEYS=

# --- ms-ai-platform -----------------------------------------------------------
# LLM providers (OpenAI-compatible gateways) are declared in
# ms-ai-platform/config/llm-providers.yaml (embedded). By default only ms-llm-gateway.
# LLM_PROVIDERS_PATH=/etc/ai-platform/llm-providers.yaml

# Where the platform reaches ms-llm-gateway, and the key it sends (one of GATEWAY_API_KEYS).
# LLM_GATEWAY_URL=http://localhost:8082/v1
# LLM_GATEWAY_API_KEY=

# Postgres used by ms-ai-platform (deploy/docker-compose.yml exposes it on 5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agentic?sslmode=disable

# Where the platform reaches demo-mcp.
DEMO_MCP_URL=http://localhost:8081/mcp

# ms-ai-platform listen address.
PORT=8080

[
  {
    "id": "core.guardrail.pii-redact",
    "kind": "guardrail",
    "domain": "core",
    "name": "PII redaction",
    "description": "Masks emails, phone numbers, CPFs and credit card numbers in user input and model output.",
    "owner": "@ai-platform",
    "tags": [
      "pii",
      "privacy"
    ],
    "lifecycle": "stable",
    "configSchema": {
      "properties": {
        "entities": {
          "items": {
            "type": "string",
            "enum": [
              "email",
              "phone",
              "cpf",
              "credit_card"
            ]
          },
          "type": "array",
          "uniqueItems": true,
          "title": "Entities to redact",
          "default": [
            "email",
            "phone",
            "cpf",
            "credit_card"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "extra": {
      "level": "L1",
      "stages": [
        "input",
        "output"
      ]
    }
  },
  {
    "id": "core.guardrail.prompt-injection",
    "kind": "guardrail",
    "domain": "core",
    "name": "Prompt injection detection",
    "description": "Blocks user messages that try to override instructions or extract the system prompt. Uses Claude Haiku as a classifier.",
    "owner": "@ai-platform",
    "tags": [
      "security"
    ],
    "lifecycle": "experimental",
    "configSchema": {
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "claude-haiku-5-5",
            "claude-haiku-4-5"
          ],
          "title": "Classifier model",
          "default": "claude-haiku-5-5"
        },
        "failMode": {
          "type": "string",
          "enum": [
            "closed",
            "open"
          ],
          "title": "When the classifier fails",
          "description": "closed blocks the message, open lets it through.",
          "default": "closed"
        },
        "timeoutMs": {
          "type": "integer",
          "maximum": 10000,
          "minimum": 500,
          "title": "Timeout (ms)",
          "default": 3000
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "extra": {
      "level": "L2",
      "stages": [
        "input"
      ]
    }
  },
  {
    "id": "core.llm.claude-haiku",
    "kind": "llm",
    "domain": "core",
    "name": "Claude Haiku",
    "description": "Anthropic's fastest, lowest-cost Claude models. Good for routing, chat and tool use.",
    "owner": "@ai-platform",
    "tags": [
      "anthropic",
      "claude"
    ],
    "lifecycle": "stable",
    "configSchema": {
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "claude-haiku-5-5",
            "claude-haiku-4-5"
          ],
          "title": "Model",
          "default": "claude-haiku-5-5"
        },
        "maxTokens": {
          "type": "integer",
          "maximum": 64000,
          "minimum": 256,
          "title": "Max output tokens",
          "default": 4096
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Effort",
          "description": "How much the model thinks before answering. Only used by claude-haiku-5-5.",
          "default": "low"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "secrets": [
      {
        "name": "ANTHROPIC_API_KEY",
        "description": "Anthropic API key"
      }
    ]
  },
  {
    "id": "core.mcp.demo",
    "kind": "mcp",
    "domain": "core",
    "name": "Demo MCP",
    "description": "Example MCP server with weather, order lookup and FAQ search tools (fake data).",
    "owner": "@ai-platform",
    "tags": [
      "demo"
    ],
    "lifecycle": "experimental",
    "configSchema": {
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "title": "Server URL",
          "description": "Overrides DEMO_MCP_URL. Leave empty to use the platform default."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "extra": {
      "allowedTools": [
        "get_weather",
        "lookup_order",
        "search_faq"
      ],
      "auth": "none",
      "transport": "streamable-http"
    }
  },
  {
    "id": "core.tool.current-time",
    "kind": "tool",
    "domain": "core",
    "name": "Current time",
    "description": "Returns the current date and time in a timezone.",
    "owner": "@ai-platform",
    "tags": [
      "utility"
    ],
    "lifecycle": "stable",
    "configSchema": {
      "properties": {
        "defaultTimezone": {
          "type": "string",
          "title": "Default timezone",
          "description": "IANA timezone, for example Europe/Lisbon.",
          "default": "UTC"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "extra": {
      "sideEffects": "read"
    }
  }
]
